# Azure OpenAI key from the Aim brief (resource aim-australia-east). Copy this file to .env.local.
AZURE_OPENAI_API_KEY=
# Live model calls are off unless this is 1. Without it the chat uses built-in shortcuts.
CHAT_LIVE=
# Daily spend cap in USD for live calls. Default 0.10, never above 0.20.
MODEL_BUDGET_USD=
